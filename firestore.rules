rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return signedIn() && myRole() == 'admin';
    }
    function isMod() {
      return signedIn() && myRole() == 'moderador';
    }
    function isStaff() {
      return isAdmin() || isMod();
    }

    match /users/{uid} {
      // Cada quien lee su perfil; admin y moderador leen todos.
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());

      // Al registrarse: solo su propio documento, SIEMPRE con rol "usuario"
      // y sin bloqueo. Nadie puede crearse como admin o moderador.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nombre', 'email', 'role', 'bloqueado', 'createdAt'])
        && request.resource.data.role == 'usuario'
        && request.resource.data.bloqueado == false
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.nombre.size() <= 40;

      // Admin: cambia rol y bloqueo de cualquiera, menos el suyo
      // (así nunca te quedas sin admin por accidente).
      allow update: if isAdmin()
        && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'bloqueado'])
        && request.resource.data.role in ['usuario', 'moderador', 'admin']
        && request.resource.data.bloqueado is bool;

      // Moderador: solo puede bloquear/desbloquear a usuarios normales.
      allow update: if isMod()
        && resource.data.role == 'usuario'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bloqueado'])
        && request.resource.data.bloqueado is bool;

      allow delete: if false;
    }

    // Todo lo demás está cerrado por defecto.
  }
}
